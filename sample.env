# Required
DEEPGRAM_API_KEY=%api_key%

# Optional (defaults shown)
# Backend API server port
PORT=8081
# Server host
HOST=0.0.0.0

# Session auth (set in production to enable nonce validation)
# SESSION_SECRET=%session_secret%

# Text-to-Speech (60db) — required only for the WS /api/tts endpoint
SIXTYDB_API_KEY=%sixtydb_api_key%
# Optional TTS overrides (defaults shown)
# TTS_PROVIDER=sixtydb
# SIXTYDB_TTS_WS_URL=wss://api.60db.ai/ws/tts
# SIXTYDB_DEFAULT_VOICE=fbb75ed2-975a-40c7-9e06-38e30524a9a1